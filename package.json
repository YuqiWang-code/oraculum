{
    "name":  "oraculum",
    "version":  "3.3.0",
    "private":  true,
    "type":  "module",
    "description":  "智能推理与预测 - 移动端优先的传统文化问卦 PWA（梅花易数/六爻纳甲）",
    "scripts":  {
                    "dev":  "vite",
                    "dev:web":  "vite",
                    "dev:server":  "tsx watch server/start.ts",
                    "dev:full":  "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
                    "build":  "vue-tsc --noEmit \u0026\u0026 vite build \u0026\u0026 npm run build:server",
                    "build:server":  "tsc -p server/tsconfig.json",
                    "start":  "node dist-server/server/start.js",
                    "preview":  "vite preview",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "lint":  "eslint . --ext .ts,.vue",
                    "format":  "prettier --write \"src/**/*.{ts,vue}\"",
                    "validate":  "tsx scripts/validate-data.ts"
                },
    "dependencies":  {
                         "concurrently":  "^10.0.5",
                         "dexie":  "^4.0.8",
                         "dotenv":  "^17.4.2",
                         "express":  "^5.2.1",
                         "express-rate-limit":  "^8.7.0",
                         "lunar-javascript":  "^1.6.13",
                         "openai":  "^7.17.0",
                         "pinia":  "^2.2.2",
                         "vue":  "^3.4.38",
                         "vue-router":  "^4.4.3",
                         "zod":  "^4.6.5"
                     },
    "devDependencies":  {
                            "@types/express":  "^5.0.6",
                            "@types/express-rate-limit":  "^5.1.3",
                            "@vitejs/plugin-vue":  "^5.1.2",
                            "@vue/test-utils":  "^2.4.6",
                            "jsdom":  "^25.0.0",
                            "prettier":  "^3.3.3",
                            "tsx":  "^4.23.13",
                            "typescript":  "^5.5.4",
                            "vite":  "^5.4.2",
                            "vite-plugin-pwa":  "^0.20.1",
                            "vitest":  "^2.0.5",
                            "vue-tsc":  "^2.0.29"
                        }
}