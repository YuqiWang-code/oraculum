# LLM 服务端配置（provider-neutral）
# 优先读取 LLM_*，兼容旧 OPENAI_*

LLM_PROVIDER=iflytek-spark
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
LLM_MODEL=spark-x2.5-4b
LLM_API_MODE=chat-completions

# 兼容旧变量（如未设 LLM_* 则回退）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Oraculum 自己的 AI API 访问口令
AI_ACCESS_TOKEN=CHANGE_ME_TO_A_PRIVATE_TOKEN

# AI 生成参数
LLM_MAX_OUTPUT_TOKENS=2500
LLM_TIMEOUT_MS=45000

PORT=8787
