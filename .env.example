# 火山方舟（豆包）API Key，真实值只放 .env，不要提交到 git
OPENAI_API_KEY=YOUR_ARK_API_KEY_HERE

# 豆包模型名或 endpoint id
OPENAI_MODEL=doubao-seed-1-6-250615

# 默认已指向火山方舟，如需切换其他兼容 OpenAI 格式的服务再改
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Oraculum 自己的 AI API 访问口令（不是模型 key）
AI_ACCESS_TOKEN=CHANGE_ME_TO_A_PRIVATE_TOKEN

# AI 生成参数
OPENAI_MAX_OUTPUT_TOKENS=2500
OPENAI_TIMEOUT_MS=45000

PORT=8787
